PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vaidyacure
# REQUIRED in production: long random string (at least 16 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Admin panel URL(s) allowed to call the API from a browser (comma-separated)
CLIENT_URL=http://localhost:3003
NODE_ENV=development

# REQUIRED for AI doctors: encrypts provider API keys stored in MongoDB (AES-256-GCM).
# 32 random bytes, base64. Use the SAME value everywhere that shares the database.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=replace_with_32_random_bytes_base64

# Optional, first run only: if the database has no AI doctors yet, a default provider
# is created from these values. Afterwards providers, models and doctors are managed
# from the admin panel (AI Doctor) and these can be removed.
# LLM_BASE_URL=https://aicredits.in/v1
# LLM_API_KEY=your_llm_api_key_here
